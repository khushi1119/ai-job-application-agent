# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Additional allowed CORS origins (comma-separated, optional)
# ALLOWED_ORIGINS=https://my-job-agent.vercel.app
# Explicit flag to allow localhost in production (strictly disabled by default in production)
# ALLOW_PRODUCTION_LOCALHOST=false

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ai_job_application_agent

# Firebase Admin SDK Configuration (Service Account)
# Download from Firebase Console: Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Cloudinary Configuration (For resume file storage)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google Gemini AI Configuration (For resume parsing and intelligence)
GEMINI_API_KEY=your-gemini-api-key

# Administrator Authorization (Required for POST /api/jobs/sync)
# Comma-separated list of authorized administrator email addresses
ADMIN_EMAILS=admin@example.com
# Comma-separated list of authorized administrator Firebase UIDs (optional)
ADMIN_UIDS=your-admin-firebase-uid
# Shared secret for automated/scheduled synchronization via X-Admin-Sync-Secret header (optional)
ADMIN_SYNC_SECRET=your-random-secure-sync-secret

# Reverse Proxy / Deployment Configuration (Optional)
# Set to 1 or true when running behind a reverse proxy (e.g. Render, Vercel, Railway, Cloudflare, ALB)
# TRUST_PROXY=1


